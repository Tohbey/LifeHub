<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reactor aggregator. Lists the modules so `./mvnw -pl <module> -am` works from the repository root.
  Versions, plugins and shared configuration live in lifehub-parent, not here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lifehub</groupId>
    <artifactId>lifehub</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LifeHub</name>

    <modules>
        <module>lifehub-parent</module>
        <module>lifehub-starter-test</module>
        <module>lifehub-starter</module>
        <module>lifehub-service-registry</module>
        <module>lifehub-web</module>
        <module>lifehub-app</module>
        <module>identity-workspace</module>
        <module>notification</module>
        <module>finance</module>
        <module>planner</module>
        <module>shopping-meals</module>
        <module>audit</module>
        <module>notes</module>
    </modules>
</project>
