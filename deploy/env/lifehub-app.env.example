# Copy to lifehub-app.env on the server. Never commit the real file.
LOGTO_ISSUER=https://auth.example.com/oidc
LOGTO_AUDIENCE=https://api.lifehub.example.com
# Only when Logto's TLS certificate comes from a private CA (mkcert): see deploy/certs/README.md.
# Leave empty for a publicly trusted certificate.
LOGTO_CA_CERT=/run/secrets/logto-ca

# Where services are looked up for lb://<name> routes.
EUREKA_URL=http://lifehub-service-registry:8761/eureka

# OpenAPI docs and Swagger UI (/swagger-ui.html). On by default; set both to false to turn them off.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
