# Copy to identity-workspace.env on the server. Never commit the real file.
LOGTO_ISSUER=https://auth.example.com/oidc
LOGTO_AUDIENCE=https://api.lifehub.example.com
LOGTO_INTERNAL_AUDIENCE=https://internal.lifehub.example.com

MYSQL_HOST=mysql
MYSQL_PORT=3306
# Runtime user: SELECT, INSERT, UPDATE, DELETE on lifehub_identity only.
DB_USER=identity_app
DB_PASSWORD=change-me
# Migration user: DDL on lifehub_identity only, used by Liquibase at startup.
DB_MIGRATION_USER=identity_migrator
DB_MIGRATION_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Where the service registers itself.
EUREKA_URL=http://lifehub-service-registry:8761/eureka

# OpenAPI docs and Swagger UI (/swagger-ui.html). On by default; set both to false to turn them off.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
