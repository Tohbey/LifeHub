# Lombok settings for the whole repository.
config.stopBubbling = true
# Mark generated code so coverage tools skip it.
lombok.addLombokGeneratedAnnotation = true
# Keep @Value on fields when @RequiredArgsConstructor builds the constructor, so Spring injects config values.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
# Lombok is for constructors, getters and loggers here. DTOs stay Java records.
lombok.data.flagUsage = error
lombok.value.flagUsage = error
